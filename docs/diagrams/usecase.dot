digraph UC {
  rankdir=LR; fontname="Helvetica"; nodesep=0.25; ranksep=1.3; bgcolor="white"; splines=true; compound=true;
  node [fontname="Helvetica", fontsize=13];
  edge [color="#1F3A5F", arrowhead=none];
  node [shape=box, style="filled,rounded", fillcolor="#1F3A5F", fontcolor="white", color="#1F3A5F", width=1.3, height=0.6];
  { rank=same; Student; Organizer; Admin; }
  node [shape=ellipse, style=filled, fillcolor="#EAF1FB", fontcolor="black", color="#1F3A5F", width=2.2, height=0.7];
  { rank=same; u1 [label="Register / sign in"]; u2 [label="Browse events\n(Current / Upcoming / Past)"]; u3 [label="Register for event\n(complete or draft)"]; u4 [label="Request organizer\naccess"]; u5 [label="Create / edit event"]; }
  
  { rank=same; u6 [label="Cancel own event"]; u7 [label="View attendees"]; u8 [label="Approve / reject\norganizer request"]; u9 [label="Delete users\nand events"]; u10 [label="View platform stats"]; }
  u1 -> u6 [style=invis];
  Student -> u1; Student -> u2; Student -> u3;
  Organizer -> u1; Organizer -> u2; Organizer -> u4; Organizer -> u5; Organizer -> u6; Organizer -> u7;
  Admin -> u1; Admin -> u7; Admin -> u8; Admin -> u9; Admin -> u10;
}
